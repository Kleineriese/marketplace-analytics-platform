    )                                           AS order_lifetime_hours

FROM [lib://QVD_STG_YM/stg_ym_orders_sales.qvd] (qvd);


// -----------------------------------------------------
// 4. Persist mart
// -----------------------------------------------------

STORE mart_unified_sales_fact
INTO [lib://QVD_MART/mart_unified_sales_fact.qvd] (qvd);

DROP TABLE mart_unified_sales_fact;